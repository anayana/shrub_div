# --- Pfade & Parameter ---
DATA_DIR  <- "C:/Users/Admin/R/Ozean/data"
OUT_FILE  <- "C:/Users/Admin/R/Ozean/data/ocean_preprocessed.rds"
LON_MIN       <- -28
LON_MAX       <- -20
LAT_MIN       <- 12
LAT_MAX       <- 20
# --- Zeitachse ---
parse_nc_time <- function(time, unit) {
origin <- sub(".*since ", "", unit)
if (grepl("days", unit))   return(as.Date(time, origin = origin))
if (grepl("hours", unit))  return(as.Date(time / 24, origin = origin))
if (grepl("seconds", unit)) return(as.Date(time / 86400, origin = origin))
as.Date(NA)
}
# --- Lade SST‑Stack ---
sst_list <- list()
dates_all <- c()
files <- list.files(DATA_DIR, pattern = "\\.nc$", full.names = TRUE)
cat("Found", length(files), "files.\n")
for (f in files) {
r <- rast(f, subds = "thetao")
r <- crop(r, ext(LON_MIN, LON_MAX, LAT_MIN, LAT_MAX))
sst_list[[length(sst_list) + 1]] <- r
ds <- nc_open(f)
time <- ncvar_get(ds, "time")
unit <- ncatt_get(ds, "time", "units")$value
nc_close(ds)
dates_all <- c(dates_all, parse_nc_time(time, unit))
}
# Kombiniere alle Zeitpunkte
sst <- rast(sst_list)
dates_all <- as.Date(dates_all)
dates_all <- dates_all[seq_len(min(length(dates_all), nlyr(sst)))]
names(sst) <- as.character(dates_all)
# Metadaten
months <- month(dates_all)
# Metadaten speichern (nicht‑Raster!)
ocean <- list(
sst   = sst,
dates = dates_all,
months = months
)
saveRDS(ocean, OUT_FILE)
cat("Gespeichert in:", OUT_FILE, "\n")
