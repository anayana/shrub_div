calculate_front_metrics <- function(sst) {
front_per_day <- rast(lapply(seq_len(nlyr(sst)), function(i) {
terrain(sst[[i]], v = "slope", unit = "degrees")
}))
names(front_per_day) <- names(sst)
front_threshold <- global(app(front_per_day, mean, na.rm = TRUE),
quantile, probs = 0.75, na.rm = TRUE)[, 1]
front_binary <- rast(lapply(seq_len(nlyr(front_per_day)), function(i) {
ifel(front_per_day[[i]] > front_threshold, 1, 0)
}))
front_frequency  <- app(front_binary, mean, na.rm = TRUE) * 100
front_sd         <- app(front_per_day, sd,  na.rm = TRUE)
front_mean       <- app(front_per_day, mean, na.rm = TRUE)
front_stability  <- front_mean / (front_sd + 0.001)
list(
per_day    = front_per_day,
frequency  = front_frequency,
stability  = front_stability,
mean       = front_mean
)
}
# --- Zonen ---
create_zone_mask <- function(sst_template) {
r     <- sst_template[[1]]
land  <- ifel(is.na(r), 1, NA)
if (global(!is.na(land), "sum", na.rm = TRUE)[1, 1] == 0) {
warning("No land pixels found. Creating simple latitude‑based zones.")
y      <- init(r, "y")
zones  <- ifel(y > mean(c(LAT_MIN, LAT_MAX)), 1, 2)
return(zones)
}
dist_to_land <- distance(land)
coastal_dist <- COASTAL_BUFFER * 111000
zones        <- ifel(dist_to_land <= coastal_dist, 1, 2)
zones        <- mask(zones, r)
zones
}
# --- Zone‑Stats ---
calculate_zone_stats <- function(raster_stack, zones, dates) {
n <- nlyr(raster_stack)
coastal_mean  <- numeric(n)
offshore_mean <- numeric(n)
for (i in 1:n) {
r               <- raster_stack[[i]]
coastal_mean[i]  <- global(mask(r, zones, maskvalues = 2), mean, na.rm = TRUE)[, 1]
offshore_mean[i] <- global(mask(r, zones, maskvalues = 1), mean, na.rm = TRUE)[, 1]
}
tibble(
date      = dates,
coastal   = coastal_mean,
offshore  = offshore_mean,
difference = coastal_mean - offshore_mean
)
}
# --- Temperaturexceedance ---
calculate_threshold_exceedance <- function(sst, thresholds = c(26, 27, 28, 29)) {
exceedance <- list()
for (thr in thresholds) {
exceed_binary <- rast(lapply(seq_len(nlyr(sst)), function(i) {
ifel(sst[[i]] > thr, 1, 0)
}))
exceedance[[as.character(thr)]] <- app(exceed_binary, sum, na.rm = TRUE)
}
exceedance
}
# --- Korrelationen ---
calculate_correlations <- function(ocean) {
sst_ts          <- global(ocean$sst,          mean, na.rm = TRUE)[, 1]
anom_ts         <- global(ocean$month_anom,    mean, na.rm = TRUE)[, 1]
mhw_ts          <- global(ocean$mhw$binary,    mean, na.rm = TRUE)[, 1]
front_ts        <- global(ocean$front_metrics$per_day, mean, na.rm = TRUE)[, 1]
df <- tibble(
date          = ocean$dates,
sst           = sst_ts,
anomaly       = anom_ts,
mhw_coverage  = mhw_ts,
front_strength = front_ts
)
cor_matrix <- cor(df[, -1], use = "pairwise.complete.obs")
list(
timeseries = df,
correlation = cor_matrix
)
}
### 1. Berechnungen durchführen
cat("Lade SST‑Daten...\n")
ocean <- load_data()
cat("Berechne MHW...\n")
ocean$mhw          <- calculate_mhw_metrics(ocean$sst)
cat("Berechne Fronten...\n")
ocean$front_metrics <- calculate_front_metrics(ocean$sst)
cat("Erzeuge Zonenmask...\n")
ocean$zones        <- create_zone_mask(ocean$sst)
cat("Berechne Zone‑Statistiken...\n")
ocean$zone_sst     <- calculate_zone_stats(ocean$sst, ocean$zones, ocean$dates)
ocean$zone_anom    <- calculate_zone_stats(ocean$month_anom, ocean$zones, ocean$dates)
cat("Berechne Thresholds > 26/27/28/29°C...\n")
ocean$threshold_exceedance <- calculate_threshold_exceedance(ocean$sst)
cat("Berechne Korrelationen...\n")
ocean$correlations <- calculate_correlations(ocean)
### 2. Save als RDS (ohne Tricks, einfach)
saveRDS(ocean, OUT_FILE)
cat("\nFertig.\n")
cat("Gespeichert nach:\n")
cat(OUT_FILE, "\n")
