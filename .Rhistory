#!/usr/bin/env Rscript
# =============================================================================
# download_data.R   (v2 - EDGAR CO2+CH4 / Jahre / Sektoren + ICOS + CDS-Satellit)
# -----------------------------------------------------------------------------
# Laedt die ECHTEN Quelldaten und legt sie unter ./data ab, so dass
# build_merge_data.R sie direkt aggregieren kann.
#
#   1) EDGAR   -> data/edgar/<Spezies>/   (TOTALS je Jahr + Sektoren im Ref-Jahr)
#                 OEFFENTLICH, ohne Login.
#   2) ICOS    -> data/icos/             (CO2 + CH4, kostenloses ICOS-Konto)
#   3) Satellit-> data/sat/<Spezies>/    (C3S XCO2/XCH4 via Copernicus CDS)
#   4) STILT   -> data/stilt/            (Footprints; nicht frei -> Hinweis)
#
# Jeder Baustein ist optional. Fehlt einer, faellt die Demo dort sauber zurueck.
#
# Aufruf:   Rscript download_data.R
# =============================================================================
`%||%` <- function(a, b) if (is.null(a) || length(a) == 0 || all(is.na(a))) b else a
msg <- function(...) cat(sprintf(...), "\n")
options(timeout = max(900, getOption("timeout")))
# --------------------------------------------------------------- Konfiguration
cfg <- list(
# ---- ICOS-Zugang (kostenlos: https://cpauth.icos-cp.eu/). Leer = ueberspringen.
icos_user = "",
icos_pass = "",
# ---- Copernicus CDS-Zugang (https://cds.climate.copernicus.eu/ -> Profil).
#      Neuer CDS: Personal Access Token in 'cds_key' eintragen. Leer = ueberspringen.
cds_key   = "",
cds_user  = "",   # bei aelterem Schluessel "UID:APIKEY" hier UID, sonst leer lassen
# ---- Was geladen wird
species     = c("CO2", "CH4"),
ref_year    = 2022,
# Jahre fuer die Zeitachse (TOTALS, je ~15 MB pro Datei/Spezies!). Nach Bedarf kuerzen.
years       = c(1990, 2000, 2010, 2015, 2018, 2020, 2021, 2022, 2023),
sat_year    = 2021, sat_month = "07",
# Sektor-Codes je Spezies (kleine Dateien ~150 KB; nicht vorhandene werden uebersprungen)
sectors = list(
CO2 = c("ENE","REF_TRF","IND","IRO","NMM","CHE","TRO","RCO","SWD_INC"),
CH4 = c("ENE","IND","TRO","RCO","PRO_FFF","ENF","MNM","SWD_LDF","WWT","AGS")
),
edgar_base  = "https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/EDGAR/datasets/EDGAR_2024_GHG",
data_dir    = "data",
icos_sparql = "https://meta.icos-cp.eu/sparql",
icos_authurl= "https://cpauth.icos-cp.eu/password/login",
overwrite   = FALSE
)
edir <- function(...) file.path(cfg$data_dir, "edgar", ...)
for (d in c(cfg$data_dir, file.path(cfg$data_dir,"icos"), file.path(cfg$data_dir,"stilt"),
file.path(cfg$data_dir,"sat"))) dir.create(d, showWarnings=FALSE, recursive=TRUE)
have_curl <- function() nzchar(Sys.which("curl"))
# ================================================================ 1) EDGAR ====
edgar_one <- function(species, year, code) {
dest_dir <- edir(species); dir.create(dest_dir, showWarnings=FALSE, recursive=TRUE)
zipname  <- sprintf("EDGAR_2024_GHG_%s_%d_%s_emi_nc.zip", species, year, code)
url      <- file.path(cfg$edgar_base, species, code, "emi_nc", zipname)
zippath  <- file.path(dest_dir, zipname)
# schon entpackt?
if (!cfg$overwrite && length(list.files(dest_dir,
pattern=sprintf("%s_%d_%s.*\\.nc$", species, year, code), ignore.case=TRUE))) return(TRUE)
ok <- tryCatch({ utils::download.file(url, zippath, mode="wb", quiet=TRUE); TRUE },
error=function(e) FALSE)
if (!ok || !file.exists(zippath) || file.info(zippath)$size < 1000) {
if (file.exists(zippath)) file.remove(zippath); return(FALSE)
}
tryCatch(utils::unzip(zippath, exdir=dest_dir, overwrite=TRUE), error=function(e) NULL)
file.remove(zippath)
TRUE
}
download_edgar <- function() {
for (sp in cfg$species) {
msg("[EDGAR] %s: TOTALS %d Jahr(e) + %d Sektor(en)", sp, length(cfg$years), length(cfg$sectors[[sp]]))
nT <- 0
for (y in cfg$years) if (edgar_one(sp, y, "TOTALS")) nT <- nT + 1
nS <- 0
for (code in cfg$sectors[[sp]]) if (edgar_one(sp, cfg$ref_year, code)) nS <- nS + 1
msg("[EDGAR] %s: %d/%d Jahre, %d/%d Sektoren geladen", sp, nT, length(cfg$years),
nS, length(cfg$sectors[[sp]]))
}
}
# ================================================================ 2) ICOS =====
icos_specs <- list(
CO2 = c("http://meta.icos-cp.eu/resources/cpmeta/atcCo2L2DataObject",
"http://meta.icos-cp.eu/resources/cpmeta/atcCo2NrtGrowingDataObject"),
CH4 = c("http://meta.icos-cp.eu/resources/cpmeta/atcCh4L2DataObject",
"http://meta.icos-cp.eu/resources/cpmeta/atcCh4NrtGrowingDataObject")
)
icos_target <- c("Cabauw","Lutjewad","Loobos","Julich","Jülich","Vielsalm",
"Geleen","Steinkimmen","Hohenpeissenberg")
icos_query <- function(specs) paste(
"prefix cpmeta: <http://meta.icos-cp.eu/ontologies/cpmeta/>",
"prefix prov: <http://www.w3.org/ns/prov#>",
"select ?dobj ?fileName ?stationName ?height where {",
paste0("  VALUES ?spec { ", paste(sprintf("<%s>", specs), collapse=" "), " }"),
"  ?dobj cpmeta:hasObjectSpec ?spec ; cpmeta:hasName ?fileName ; cpmeta:wasAcquiredBy ?acq .",
"  ?acq prov:wasAssociatedWith ?station . ?station cpmeta:hasName ?stationName .",
"  OPTIONAL { ?dobj cpmeta:hasSamplingHeight ?height }",
"  FILTER NOT EXISTS { [] cpmeta:isNextVersionOf ?dobj }",
"}", sep="\n")
icos_token <- function() {
user <- if (nzchar(cfg$icos_user)) cfg$icos_user else Sys.getenv("ICOS_USER")
pass <- if (nzchar(cfg$icos_pass)) cfg$icos_pass else Sys.getenv("ICOS_PASS")
if (!nzchar(user) || !nzchar(pass)) {
msg("[ICOS] Keine Zugangsdaten -> uebersprungen. (icos_user/icos_pass oben eintragen)"); return(NA_character_)
}
if (!have_curl()) { msg("[ICOS] 'curl' fehlt -> uebersprungen."); return(NA_character_) }
ckj <- tempfile()
system2("curl", c("-s","-c",ckj,"--data-urlencode",sprintf("mail=%s",user),
"--data-urlencode",sprintf("password=%s",pass), cfg$icos_authurl), stdout=NULL, stderr=NULL)
tok <- NA_character_
if (file.exists(ckj)) { h <- grep("cpauthToken", readLines(ckj, warn=FALSE), value=TRUE)
if (length(h)) tok <- sub(".*cpauthToken\\s+", "", h[length(h)]) }
if (is.na(tok) || !nzchar(tok)) msg("[ICOS] Login fehlgeschlagen.")
tok
}
download_icos <- function() {
if (!requireNamespace("jsonlite", quietly=TRUE)) { msg("[ICOS] 'jsonlite' fehlt -> uebersprungen."); return() }
if (!have_curl()) { msg("[ICOS] 'curl' fehlt -> uebersprungen."); return() }
tok <- icos_token(); if (is.na(tok)) return()
for (sp in cfg$species) {
# SPARQL per GET (robust unter Windows; der Endpoint liefert JSON zurueck).
url <- paste0(cfg$icos_sparql, "?query=",
utils::URLencode(icos_query(icos_specs[[sp]]), reserved = TRUE))
of  <- tempfile(fileext = ".json")
ok  <- tryCatch({ utils::download.file(url, of, mode = "wb", quiet = TRUE); TRUE },
error = function(e) FALSE)
if (!ok || !file.exists(of) || file.info(of)$size == 0) { msg("[ICOS] %s: SPARQL ohne Antwort.", sp); next }
res <- tryCatch(jsonlite::fromJSON(of), error=function(e) NULL)
rows <- res$results$bindings
if (is.null(rows) || NROW(rows) == 0) { msg("[ICOS] %s: nichts gefunden.", sp); next }
gc2 <- function(nm) if (!is.null(rows[[nm]])) rows[[nm]]$value else rep(NA_character_, NROW(rows))
df <- data.frame(dobj=gc2("dobj"), station=gc2("stationName"),
height=suppressWarnings(as.numeric(gc2("height"))), stringsAsFactors=FALSE)
df <- df[grepl(paste(icos_target, collapse="|"), df$station, ignore.case=TRUE), , drop=FALSE]
if (!nrow(df)) { msg("[ICOS] %s: keine Zielstation im Release.", sp); next }
h <- df$height; h[is.na(h)] <- -Inf
df <- df[order(df$station, -h), , drop=FALSE]; df <- df[!duplicated(df$station), , drop=FALSE]
n_ok <- 0
for (i in seq_len(nrow(df))) {
url  <- sub("meta\\.icos-cp\\.eu","data.icos-cp.eu", df$dobj[i])
dest <- file.path(cfg$data_dir,"icos", sprintf("%s.%s",
gsub("[^A-Za-z0-9]+","_", df$station[i]), tolower(sp)))
if (!cfg$overwrite && file.exists(dest)) { n_ok <- n_ok+1; next }
system2("curl", c("-s","-L","--cookie",sprintf("cpauthToken=%s",tok), url, "-o", dest), stdout=NULL, stderr=NULL)
if (file.exists(dest) && file.info(dest)$size > 1000) n_ok <- n_ok+1 else if (file.exists(dest)) file.remove(dest)
}
msg("[ICOS] %s: %d Stationsdatei(en)", sp, n_ok)
}
}
# ============================================================ 3) Satellit =====
# C3S-Produkte ueber Copernicus CDS (R-Paket ecmwfr). XCO2 / XCH4, Level 3.
download_sat <- function() {
key <- if (nzchar(cfg$cds_key)) cfg$cds_key else Sys.getenv("CDS_KEY")
if (!nzchar(key)) { msg("[SAT] Kein CDS-Schluessel (cds_key) -> Satellit uebersprungen."); return() }
if (!requireNamespace("ecmwfr", quietly=TRUE)) {
msg("[SAT] Paket 'ecmwfr' fehlt -> install.packages('ecmwfr'). Satellit uebersprungen."); return() }
user <- if (nzchar(cfg$cds_user)) cfg$cds_user else "ecmwfr"
tryCatch(ecmwfr::wf_set_key(user=user, key=key, service="cds"),
error=function(e) tryCatch(ecmwfr::wf_set_key(key=key), error=function(e2) NULL))
ds  <- list(CO2="satellite-carbon-dioxide", CH4="satellite-methane")
var <- list(CO2="xco2", CH4="xch4")
for (sp in cfg$species) {
outdir <- file.path(cfg$data_dir,"sat", sp); dir.create(outdir, showWarnings=FALSE, recursive=TRUE)
target <- sprintf("c3s_%s_%s%s.zip", tolower(sp), cfg$sat_year, cfg$sat_month)
# Vorlage-Request fuer das C3S-Saeulenprodukt. Bei Bedarf an die exakten
# Parameter des CDS-Datensatzes anpassen (Button "Show API request").
req <- list(
dataset_short_name = ds[[sp]],
processing_level   = "level_3",
variable           = var[[sp]],
sensor_and_algorithm = if (sp=="CO2") "merged_obs4mips" else "merged_obs4mips",
version            = "4.5",
year               = as.character(cfg$sat_year),
month              = cfg$sat_month,
format             = "zip",
target             = target
)
msg("[SAT] %s: CDS-Anfrage %s ...", sp, ds[[sp]])
ok <- tryCatch({ ecmwfr::wf_request(request=req, user=user, path=outdir, time_out=3600); TRUE },
error=function(e) { msg("[SAT] %s: Anfrage fehlgeschlagen: %s", sp, conditionMessage(e)); FALSE })
if (ok) {
zp <- file.path(outdir, target)
if (file.exists(zp)) tryCatch(utils::unzip(zp, exdir=outdir, overwrite=TRUE), error=function(e) NULL)
msg("[SAT] %s: geladen nach %s", sp, outdir)
} else {
msg("[SAT] %s: Tipp - exakten Request im CDS unter '%s' kopieren und 'req' oben anpassen.", sp, ds[[sp]])
}
}
}
# =============================================================== 4) STILT =====
stilt_hint <- function() {
if (length(list.files(file.path(cfg$data_dir,"stilt"), pattern="\\.nc$"))) {
msg("[STILT] Footprints vorhanden -> werden genutzt."); return() }
msg("[STILT] Footprints nicht frei abrufbar. ICOS-Tool: https://stilt.icos-cp.eu/worker/")
msg("[STILT] Ablage als data/stilt/foot_<NAME>.nc; sonst parametrisierter Operator K.")
}
# ==================================================================== main ====
main <- function() {
msg("================= download_data.R (v2) =================")
download_edgar()
download_icos()
download_sat()
stilt_hint()
msg("-------------------------------------------------------")
msg("Naechster Schritt:  Rscript build_merge_data.R")
}
